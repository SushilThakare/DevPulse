# ==============================================
# Server Configuration
# ==============================================
PORT=5000
NODE_ENV=development

# ==============================================
# Client / CORS
# ==============================================
CLIENT_URL=http://localhost:3000

# ==============================================
# Database (PostgreSQL / Prisma)
# ==============================================
# Replace with your PostgreSQL connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/devpulse?schema=public"

# ==============================================
# Authentication & Security
# ==============================================
# Secret key used to sign and verify JWT tokens
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==============================================
# GitHub OAuth App
# ==============================================
# Create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ==============================================
# AI / LLM Integration (for Weekly Reports)
# ==============================================
# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=
# Or OpenAI API Key (optional):
# OPENAI_API_KEY=

# ==============================================
# Background Job Queue (Optional)
# ==============================================
REDIS_URL=redis://localhost:6379
